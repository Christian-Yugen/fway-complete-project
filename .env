# Fway - Variáveis de Ambiente do Projeto Completo

# ===================================
# CONFIGURAÇÕES GERAIS
# ===================================
NODE_ENV=development
PROJECT_NAME=fway

# ===================================
# BACKEND (API)
# ===================================

# Servidor
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# Banco de Dados
# Para desenvolvimento local (SQLite)
DATABASE_URL="file:./data/fway.db"

# Para produção (PostgreSQL)
# DATABASE_URL="postgresql://username:password@localhost:5432/fway"

# PostgreSQL (se usando Docker Compose)
POSTGRES_DB=fway
POSTGRES_USER=fway
POSTGRES_PASSWORD=fway123
POSTGRES_PORT=5432

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Cache e Sessões)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logs
LOG_LEVEL=info

# Email (Opcional)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS (Opcional)
SMS_SERVICE=twilio
SMS_ACCOUNT_SID=your-twilio-sid
SMS_AUTH_TOKEN=your-twilio-token

# Upload
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Swagger (Documentação)
SWAGGER_ENABLED=true

# ===================================
# FRONTEND (React PWA)
# ===================================

# URL da API Backend
VITE_API_URL=http://localhost:3001

# Configurações da PWA
VITE_APP_NAME=Fway
VITE_APP_SHORT_NAME=Fway
VITE_APP_DESCRIPTION=Sistema de Saúde Digital

# Google Maps (se necessário)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase (se necessário para notificações push)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ===================================
# DOCKER COMPOSE
# ===================================

# Portas expostas
API_PORT=3001
FRONTEND_PORT=5173
NGINX_PORT=80
NGINX_SSL_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Build target
BUILD_TARGET=production

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# ===================================
# PRODUÇÃO
# ===================================

# Domínio
DOMAIN=fway.com
API_DOMAIN=api.fway.com
APP_DOMAIN=app.fway.com

# SSL
SSL_EMAIL=admin@fway.com

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoramento
SENTRY_DSN=your-sentry-dsn
ANALYTICS_ID=your-analytics-id

