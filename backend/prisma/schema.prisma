// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Modelo de usuário
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  status    String   @default("PENDING_VERIFICATION")
  
  // Informações pessoais
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  birthDate DateTime?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  
  // Verificação de email
  emailVerified Boolean @default(false)
  emailVerificationToken String?
  
  // Reset de senha
  passwordResetToken String?
  passwordResetExpires DateTime?
  
  // Relacionamentos
  profile       UserProfile?
  refreshTokens RefreshToken[]
  bookings      Booking[]
  reviews       Review[]
  medicalProfile       MedicalProfile?
  aiInteractions       AIInteraction[]
  triageResults        TriageResult[]
  symptomAnalyses      SymptomAnalysis[]
  riskAssessments      RiskAssessment[]
  aiRecommendations    AIRecommendation[]
  intelligentMatches   IntelligentMatch[]
  userShield           UserShield?
  userCoverages        UserCoverage[]
  claims               Claim[]
  userRewards          UserReward[]
  dynamicPricingLogs   DynamicPricingLog[]
  
  @@map("users")
}

// Perfil detalhado do usuário
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  bio    String?
  avatarUrl String?
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Informações adicionais
  cpf       String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  country   String? @default("Brasil")
  
  // Preferências
  language  String? @default("pt-BR")
  timezone  String? @default("America/Sao_Paulo")
  
  // Configurações de notificação
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  pushNotifications  Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("user_profiles")
}

// Tokens de refresh JWT
model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@map("refresh_tokens")
}

// Modelo de profissional
model Professional {
  id     String @id @default(cuid())
  userId String @unique
  
  // Informações profissionais
  type           String
  specialization String
  license        String @unique
  experience     Int    // anos de experiência
  
  // Localização
  address    String
  city       String
  state      String
  zipCode    String
  latitude   Float?
  longitude  Float?
  
  // Configurações
  isActive      Boolean @default(true)
  isVerified    Boolean @default(false)
  consultationFee Float?
  
  // Horários de trabalho (JSON)
  workingHours String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamentos
  services  Service[]
  bookings  Booking[]
  reviews   Review[]
  intelligentMatches IntelligentMatch[] // Opposite relation for IntelligentMatch

  @@map("professionals")
}

// Serviços oferecidos pelos profissionais
model Service {
  id             String @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  price       Float
  duration    Int    // em minutos
  isActive    Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamentos
  bookings Booking[]
  
  @@map("services")
}

// Agendamentos
model Booking {
  id             String @id @default(cuid())
  date           DateTime
  userId         String
  user           User   @relation(fields: [userId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  userCoverageId String?
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  
  // Detalhes do agendamento
  scheduledAt DateTime
  status      String @default("PENDING")
  notes       String?
  
  // Valores
  price       Float
  paymentStatus String? @default("PENDING")
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relacionamentos
  review Review?
  
  @@map("bookings")
}

// Avaliações
model Review {
  id        String @id @default(cuid())
  bookingId String @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  content   String
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  
  rating    Int    // 1-5
  comment   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("reviews")
}

// Logs de auditoria
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@map("audit_logs")
}

// Modelos de dados aprimorados para FWAY Brain - IA Médica
// Adicionar ao schema.prisma existente

// ===== MODELOS PARA IA MÉDICA AVANÇADA =====

// Perfil médico detalhado do usuário
model MedicalProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  
  // Informações básicas de saúde
  bloodType    String?  // Tipo sanguíneo
  height       Float?   // Altura em cm
  weight       Float?   // Peso em kg
  allergies    String?
  conditions   String?  // JSON array com alergias
  chronicConditions String? // JSON array com condições crônicas
  
  // Histórico familiar
  familyHistory String? // JSON com histórico familiar de doenças
  
  // Estilo de vida
  smokingStatus String? // NEVER, FORMER, CURRENT
  alcoholConsumption String? // NONE, LIGHT, MODERATE, HEAVY
  exerciseFrequency String? // SEDENTARY, LIGHT, MODERATE, INTENSE
  dietType     String?  // OMNIVORE, VEGETARIAN, VEGAN, etc.
  
  // Medicamentos atuais
  currentMedications String? // JSON array com medicamentos
  
  // Dados vitais mais recentes
  lastBloodPressure String? // Pressão arterial
  lastHeartRate    Int?     // Frequência cardíaca
  lastGlucose      Float?   // Glicemia
  lastCholesterol  Float?   // Colesterol
  
  // Preferências de atendimento
  preferredLanguage String? @default("pt-BR")
  communicationStyle String? // DIRECT, DETAILED, SIMPLE
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relacionamentos
  triageResults     TriageResult[]
  symptomAnalyses   SymptomAnalysis[]
  riskAssessments   RiskAssessment[]
  aiRecommendations AIRecommendation[]
  
  @@map("medical_profiles")
}

// Interações com IA
model AIInteraction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message         String  // ID da mensagem associada (se aplicável)
  response       String  // Resposta da IA
  // Tipo de interação
  type            String   // CHAT, TRIAGE, SENTIMENT, NLP, RECOMMENDATION, RISK_ASSESSMENT, etc.
  
  // Dados da interação
  input           String   // Input do usuário
  output          String   // Output da IA
  confidence      Float    // Confiança da IA (0-1)
  processingTime  Int      // Tempo de processamento em ms
  
  // Contexto e metadados
  sessionId       String?  // ID da sessão (para chats)
  context         String?  // Contexto da interação
  metadata        String?  // JSON com metadados adicionais
  
  // Feedback do usuário
  userRating      Int?     // 1-5 rating do usuário
  userFeedback    String?  // Feedback textual
  
  // Timestamps
  createdAt       DateTime @default(now())
  
  @@map("ai_interactions")
}

// Resultados de triagem inteligente
model TriageResult {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalProfileId  String?
  medicalProfile    MedicalProfile? @relation(fields: [medicalProfileId], references: [id])
  
  // Dados de entrada
  symptoms          String   // JSON array com sintomas
  severity          String   // LOW, MEDIUM, HIGH
  duration          String   // Duração dos sintomas
  
  // Resultado da triagem
  urgencyLevel      String   // LOW, MEDIUM, HIGH, EMERGENCY
  confidence        Float    // Confiança da IA
  
  // Análise da IA
  possibleConditions String  // JSON array com possíveis condições
  recommendations   String   // JSON array com recomendações
  aiAnalysis        String   // JSON com análise detalhada da IA
  
  // Dados do paciente no momento da triagem
  patientAge        Int?
  patientGender     String?
  patientHistory    String?  // JSON com histórico relevante
  
  // Follow-up
  followUpRequired  Boolean  @default(false)
  followUpDate      DateTime?
  
  // Validação médica (se aplicável)
  medicalValidation String?  // Validação por profissional
  validatedBy       String?  // ID do profissional que validou
  validatedAt       DateTime?
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("triage_results")
}

// Análise de sintomas avançada
model SymptomAnalysis {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalProfileId  String
  medicalProfile    MedicalProfile? @relation(fields: [medicalProfileId], references: [id])
  
  // Sintomas analisados
  symptoms          String   // JSON array com sintomas detalhados
  symptomDuration   String   // Duração dos sintomas
  symptomProgression String? // Como os sintomas evoluíram
  
  // Análise da IA
  analysis          String   // JSON com análise completa
  possibleConditions String  // JSON array com condições possíveis
  confidence        Float    // Confiança geral da análise
  urgencyLevel      String   // LOW, MEDIUM, HIGH, EMERGENCY
  
  // Recomendações
  recommendations   String   // JSON array com recomendações
  nextSteps         String   // JSON array com próximos passos
  
  // Fatores considerados
  riskFactors       String?  // JSON com fatores de risco considerados
  protectiveFactors String?  // JSON com fatores protetivos
  
  // Especialidades recomendadas
  recommendedSpecialties String? // JSON array com especialidades
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("symptom_analyses")
}

// Avaliações de risco de saúde
model RiskAssessment {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalProfileId  String
  medicalProfile    MedicalProfile? @relation(fields: [medicalProfileId], references: [id])
  
  // Fatores de risco avaliados
  factors           String   // JSON com fatores de risco
  riskScore         Float    // Score de risco (0-100)
  riskLevel         String   // LOW, MEDIUM, HIGH, VERY_HIGH
  confidence        Float    // Confiança da avaliação
  
  // Análise detalhada
  analysis          String   // JSON com análise detalhada
  recommendations   String   // JSON array com recomendações
  preventiveMeasures String  // JSON array com medidas preventivas
  
  // Categorias de risco
  cardiovascularRisk Float?  // Risco cardiovascular
  diabetesRisk      Float?   // Risco de diabetes
  cancerRisk        Float?   // Risco de câncer
  mentalHealthRisk  Float?   // Risco de problemas mentais
  
  // Fatores modificáveis
  modifiableFactors String?  // JSON com fatores que podem ser modificados
  
  // Acompanhamento
  nextAssessmentDate DateTime? // Próxima avaliação recomendada
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("risk_assessments")
}

// Recomendações personalizadas da IA
model AIRecommendation {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recomendationId     String  // ID da recomendação associada (se aplicável)
  medicalProfileId  String
  medicalProfile    MedicalProfile? @relation(fields: [medicalProfileId], references: [id])
  
  // Tipo de recomendação
  type              String   // PROFESSIONAL, EXAM, LIFESTYLE, MEDICATION, PREVENTION
  category          String   // URGENT, ROUTINE, PREVENTIVE, WELLNESS
  
  // Conteúdo da recomendação
  title             String
  description       String
  recommendations   String   // JSON array com recomendações detalhadas
  reasoning         String   // JSON com raciocínio da IA
  
  // Prioridade e confiança
  priority          String   // LOW, MEDIUM, HIGH, URGENT
  confidence        Float    // Confiança da IA
  
  // Dados contextuais
  basedOnSymptoms   String?  // JSON com sintomas que geraram a recomendação
  basedOnHistory    String?  // JSON com histórico considerado
  basedOnRisk       String?  // JSON com fatores de risco considerados
  
  // Status da recomendação
  status            String   @default("PENDING") // PENDING, VIEWED, ACCEPTED, REJECTED, COMPLETED
  userFeedback      String?  // Feedback do usuário
  userRating        Int?     // Rating 1-5
  
  // Validade
  validUntil        DateTime? // Até quando a recomendação é válida
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("ai_recommendations")
}

// Matching inteligente entre pacientes e profissionais
model IntelligentMatch {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId    String
  score             Float    // Score de compatibilidade (0-100)
  professional      Professional @relation(fields: [professionalId], references: [id])
  
  // Dados do matching
  matchScore        Float    // Score de compatibilidade (0-100)
  confidence        Float    // Confiança do algoritmo
  
  // Fatores considerados
  specialtyMatch    Float    // Compatibilidade de especialidade
  locationMatch     Float    // Compatibilidade de localização
  availabilityMatch Float    // Compatibilidade de disponibilidade
  experienceMatch   Float    // Compatibilidade de experiência
  personalityMatch  Float?   // Compatibilidade de personalidade
  languageMatch     Float?   // Compatibilidade de idioma
  
  // Razões do match
  matchReasons      String   // JSON array com razões do match
  
  // Contexto do matching
  requestContext    String   // JSON com contexto da solicitação
  symptoms          String?  // Sintomas que motivaram o match
  urgencyLevel      String?  // Nível de urgência
  
  // Resultado
  status            String   @default("SUGGESTED") // SUGGESTED, CONTACTED, BOOKED, REJECTED
  userFeedback      String?  // Feedback do usuário sobre o match
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("intelligent_matches")
}

// Base de conhecimento médico
model MedicalKnowledge {
  id                String   @id @default(cuid())
  
  // Identificação
  code              String   @unique // Código único (ex: ICD-10)
  name              String   // Nome da condição/procedimento
  category          String   // Categoria médica
  specialty         String   // Especialidade médica
  
  // Descrição
  description       String   // Descrição detalhada
  symptoms          String   // JSON array com sintomas
  causes            String?  // JSON array com causas
  riskFactors       String?  // JSON array com fatores de risco
  
  // Tratamento
  treatments        String?  // JSON array com tratamentos
  medications       String?  // JSON array com medicamentos
  procedures        String?  // JSON array com procedimentos
  
  // Prognóstico
  prognosis         String?  // Prognóstico geral
  complications     String?  // JSON array com complicações possíveis
  
  // Prevenção
  prevention        String?  // JSON array com medidas preventivas
  
  // Dados epidemiológicos
  prevalence        Float?   // Prevalência na população
  incidence         Float?   // Incidência anual
  mortality         Float?   // Taxa de mortalidade
  
  // Metadados
  sources           String?  // JSON array com fontes
  lastReviewed      DateTime? // Última revisão
  confidence        Float    @default(1.0) // Confiança na informação
  
  // Status
  isActive          Boolean  @default(true)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("medical_knowledge")
}

// Interações medicamentosas
model DrugInteraction {
  id                String   @id @default(cuid())
  
  // Medicamentos
  drug1             String   // Nome do primeiro medicamento
  drug2             String   // Nome do segundo medicamento
  
  // Tipo de interação
  interactionType   String   // MAJOR, MODERATE, MINOR
  severity          String   // HIGH, MEDIUM, LOW
  
  // Descrição da interação
  description       String   // Descrição da interação
  mechanism         String?  // Mecanismo da interação
  effects           String   // JSON array com efeitos
  
  // Recomendações
  recommendations   String   // JSON array com recomendações
  alternatives      String?  // JSON array com alternativas
  
  // Monitoramento
  monitoring        String?  // JSON array com parâmetros a monitorar
  
  // Metadados
  sources           String?  // JSON array com fontes
  confidence        Float    @default(1.0)
  
  // Status
  isActive          Boolean  @default(true)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("drug_interactions")
}

// Modelos de IA treinados
model AIModel {
  id                String   @id @default(cuid())
  
  // Identificação
  name              String   // Nome do modelo
  version           String   // Versão do modelo
  type              String   // TRIAGE, SYMPTOM_ANALYSIS, RISK_ASSESSMENT, etc.
  
  // Configuração
  modelPath         String?  // Caminho para o modelo
  parameters        String   // JSON com parâmetros do modelo
  hyperparameters   String?  // JSON com hiperparâmetros
  
  // Performance
  accuracy          Float?   // Acurácia do modelo
  precision         Float?   // Precisão
  recall            Float?   // Recall
  f1Score           Float?   // F1 Score
  
  // Dados de treinamento
  trainingDataSize  Int?     // Tamanho do dataset de treinamento
  validationDataSize Int?    // Tamanho do dataset de validação
  testDataSize      Int?     // Tamanho do dataset de teste
  
  // Metadados
  description       String?  // Descrição do modelo
  trainedBy         String?  // Quem treinou o modelo
  trainedAt         DateTime? // Quando foi treinado
  
  // Status
  isActive          Boolean  @default(false)
  isProduction      Boolean  @default(false)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("ai_models")
}

