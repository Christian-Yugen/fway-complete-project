// Modelos de dados aprimorados para FWAY Shield - Microsseguros Dinâmicos
// Adicionar ao schema.prisma existente

// ===== MODELOS PARA MICROSSEGUROS DINÂMICOS =====

// Configuração do Shield do usuário
model UserShield {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Score de risco dinâmico
  riskScore    Float    @default(85.0)  // 0-100, menor = menor risco
  riskFactors  String?  // JSON com fatores de risco detalhados
  
  // Nível do Shield
  shieldLevel  String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  totalPoints  Int      @default(0)
  
  // Configurações
  isActive     Boolean  @default(true)
  autoRenewal  Boolean  @default(true)
  
  // Dados epidemiológicos
  region       String?  // Para ajuste de risco regional
  zipCode      String?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relacionamentos
  coverage    UserCoverage[] @relation("UserShieldToUserCoverage")
  claims       Claim[]
  rewards      UserReward[]
  riskHistory  RiskScoreHistory[]
  
  @@map("user_shields")
}

// Tipos de cobertura disponíveis
model Coverage {
  id          String   @id @default(cuid())
  
  // Informações básicas
  name        String
  description String
  type        String   // BASIC, EXTENDED, EMERGENCY, FAMILY
  category    String   // CONSULTATION, EXAM, PROCEDURE, EMERGENCY
  
  // Configuração de preços
  baseRate    Float    // Taxa base para cálculo do prêmio
  minPremium  Float    // Prêmio mínimo
  maxPremium  Float    // Prêmio máximo
  
  // Limites de cobertura
  maxCoverage Float    // Valor máximo de cobertura
  deductible  Float?   // Franquia
  
  // Configurações
  isActive    Boolean  @default(true)
  isPerTransaction Boolean @default(true) // Se é ativado por transação
  
  // Duração padrão (em dias)
  defaultDuration Int @default(30)
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relacionamentos
  userCoverages UserCoverage[]
  
  @@map("coverages")
}

// Cobertura ativa do usuário (microsseguro por transação)
model UserCoverage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverageId String
  coverage   Coverage @relation(fields: [coverageId], references: [id])
  userShieldId String?
  userShield   UserShield? @relation("UserShieldToUserCoverage", fields: [userShieldId], references: [id])
  
  // Detalhes da transação
  serviceId     String?  // ID do serviço/agendamento que ativou o seguro
  serviceValue  Float    // Valor do serviço coberto
  premium       Float    // Prêmio calculado dinamicamente
  
  // Período de cobertura
  startDate     DateTime
  endDate       DateTime
  duration      Int      // Duração em dias
  
  // Status
  isActive      Boolean  @default(true)
  status        String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, CLAIMED
  
  // Dados da precificação dinâmica
  riskScoreAtCreation Float // Risk score no momento da criação
  epidemiologicalData String? // JSON com dados epidemiológicos usados
  pricingFactors      String? // JSON com fatores usados na precificação
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relacionamentos
  claims        Claim[]
  
  @@map("user_coverages")
}

// Sinistros/Claims
model Claim {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  userShieldId     String
  userShield       UserShield @relation(fields: [userShieldId], references: [id])
  coverageId       String
  coverage         UserCoverage @relation(fields: [coverageId], references: [id])
  
  // Detalhes do sinistro
  type             String   // CONSULTATION, EXAM, PROCEDURE, EMERGENCY
  description      String
  amount           Float    // Valor solicitado
  
  // Status e processamento
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSING
  severity         String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  
  // Análise por IA/NLP
  nlpAnalysis      String?  // JSON com análise de linguagem natural
  aiConfidence     Float?   // Confiança da IA na análise (0-1)
  autoProcessed    Boolean  @default(false)
  
  // Aprovação/Rejeição
  approvedAt       DateTime?
  approvedBy       String?  // ID do usuário ou "SYSTEM_AI"
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectionReason  String?
  
  // Pagamento
  payoutAmount     Float?
  payoutDate       DateTime?
  payoutMethod     String?
  
  // Anexos
  attachments      String?  // JSON array com URLs dos anexos
  
  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relacionamentos
  messages         ClaimMessage[]
  
  @@map("claims")
}

// Mensagens do sinistro (chat)
model ClaimMessage {
  id          String   @id @default(cuid())
  claimId     String
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  senderId    String   // ID do usuário ou sistema
  message     String   // Mensagem enviada
  timestamp   DateTime @default(now())
  // Conteúdo
  content     String
  type        String   @default("TEXT") // TEXT, IMAGE, DOCUMENT, SYSTEM
  
  // Análise NLP
  nlpAnalysis String?  // JSON com análise da mensagem
  
  // Timestamps
  createdAt   DateTime @default(now())
  
  @@map("claim_messages")
}

// Histórico de risk score
model RiskScoreHistory {
  id           String   @id @default(cuid())
  userShieldId String
  userShield   UserShield @relation(fields: [userShieldId], references: [id], onDelete: Cascade)
  
  // Dados do score
  riskScore    Float
  factors      String   // JSON com fatores que influenciaram o score
  trigger      String   // O que causou a atualização (BOOKING, CLAIM, PERIODIC, etc.)
  score        Float?   // Score calculado (0-100)

  // Timestamps
  createdAt    DateTime @default(now())
  
  @@map("risk_score_history")
}

// Dados epidemiológicos por região
model EpidemiologicalData {
  id           String   @id @default(cuid())
  
  // Localização
  region       String
  state        String
  city         String?
  zipCode      String?
  
  // Dados de saúde
  diseaseType  String   // Tipo de doença/condição
  incidence    Float    // Taxa de incidência
  severity     Float    // Severidade média
  seasonality  String?  // JSON com dados de sazonalidade
  
  // Período dos dados
  periodStart  DateTime
  periodEnd    DateTime
  
  // Fonte dos dados
  source       String
  reliability  Float    @default(1.0) // 0-1, confiabilidade da fonte
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("epidemiological_data")
}

// Algoritmos atuariais configuráveis
model ActuarialModel {
  id           String   @id @default(cuid())
  
  // Identificação
  name         String
  version      String
  description  String?
  
  // Configuração do modelo
  formula      String   // Fórmula matemática ou referência ao algoritmo
  parameters   String   // JSON com parâmetros do modelo
  weights      String   // JSON com pesos dos fatores
  
  // Aplicabilidade
  coverageTypes String  // JSON array com tipos de cobertura aplicáveis
  riskFactors   String  // JSON array com fatores de risco considerados
  
  // Status
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  
  // Validação
  accuracy     Float?   // Precisão do modelo (0-1)
  lastTested   DateTime?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("actuarial_models")
}

// Recompensas do Shield
model Reward {
  id           String   @id @default(cuid())
  
  // Informações básicas
  name         String
  description  String
  type         String   // DISCOUNT, CASHBACK, UPGRADE, BENEFIT
  
  // Custo e benefício
  pointsCost   Int
  value        Float?   // Valor monetário do benefício
  discount     Float?   // Percentual de desconto
  
  // Configurações
  isActive     Boolean  @default(true)
  isRepeatable Boolean  @default(false)
  maxRedemptions Int?   // Máximo de resgates por usuário
  
  // Validade
  validFrom    DateTime?
  validUntil   DateTime?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relacionamentos
  userRewards  UserReward[]
  
  @@map("rewards")
}

// Recompensas resgatadas pelo usuário
model UserReward {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userShieldId String
  userShield   UserShield @relation(fields: [userShieldId], references: [id])
  rewardId     String
  reward       Reward   @relation(fields: [rewardId], references: [id])
  
  // Detalhes do resgate
  pointsSpent  Int
  status       String   @default("ACTIVE") // ACTIVE, USED, EXPIRED
  
  // Uso
  usedAt       DateTime?
  expiresAt    DateTime?
  
  // Timestamps
  earnedAt     DateTime @default(now())
  
  @@map("user_rewards")
}

// Transações de precificação dinâmica (log)
model DynamicPricingLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  price            Float    // Preço calculado
  coverageId       String
  
  // Dados da transação
  serviceValue     Float
  calculatedPremium Float
  finalPremium     Float    // Pode ser diferente se houver descontos
  
  // Fatores de precificação
  riskScore        Float
  baseRate         Float
  riskMultiplier   Float
  regionalFactor   Float
  seasonalFactor   Float?
  discountApplied  Float?
  
  // Dados epidemiológicos usados
  epidemiologicalFactors String? // JSON
  
  // Modelo atuarial usado
  actuarialModelId String?
  modelVersion     String?
  
  // Resultado
  approved         Boolean
  reason           String?  // Motivo se rejeitado
  
  // Timestamps
  createdAt        DateTime @default(now())
  timestamp        DateTime @default(now())
  
  @@map("dynamic_pricing_logs")
}



